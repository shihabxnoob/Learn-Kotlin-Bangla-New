---
import Button from '../ui/Button.astro';
import CodeBlock from '../ui/CodeBlock.astro';
---
<section class="hero">
  <div class="container grid">
    <div class="copy">
      <h1>Kotlin শিখুন, ধাপে ধাপে, নিজের ভাষায়</h1>
      <p>ভ্যারিয়েবল থেকে coroutines পর্যন্ত, সহজ বাংলায় ও ছোট ছোট কোড উদাহরণে। কোথা থেকে শুরু করবেন সেই চিন্তা ছাড়াই এগিয়ে যান।</p>
      <div class="cta">
        <Button href="#roadmap">Lesson শুরু করুন</Button>
        <Button href="#roadmap" variant="outline">Roadmap দেখুন</Button>
      </div>
    </div>
    <div class="visual">
      <CodeBlock filename="Main.kt">
  <span class="kw">fun</span> <span class="fn">main</span>() &#123;
  <span class="kw">val</span> name = <span class="str">&quot;Kotlin Shikhi&quot;</span>
  <span class="fn">println</span>(<span class="str">&quot;স্বাগতম, $&#123;name&#125;!&quot;</span>)
&#125;</CodeBlock>
    </div>
  </div>
</section>
<style>
  .hero { padding-block: var(--s12) var(--s16); background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 48px 48px; background-position: -1px -1px; -webkit-mask-image: linear-gradient(#000 55%, transparent); mask-image: linear-gradient(#000 55%, transparent); }
  .grid { display: grid; gap: var(--s12); align-items: center; }
  .copy { display: grid; gap: var(--s6); justify-items: start; }
  .copy p { color: var(--muted); font-size: 1.125rem; max-width: 36em; }
  .cta { display: flex; flex-direction: column; gap: var(--s3); width: 100%; }
  .visual {  animation: rise .6s ease-out both; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  @media (min-width: 600px) { .cta { flex-direction: row; width: auto; } }
  @media (min-width: 1024px) { .hero { padding-block: var(--s24); } .grid { grid-template-columns: 1.1fr .9fr; gap: var(--s16); } }
</style>
