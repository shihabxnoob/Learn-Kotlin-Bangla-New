---
interface Props { filename: string }
const { filename } = Astro.props;
---
<figure>
  <figcaption><i></i><i></i><i></i><span>{filename}</span></figcaption>
  <pre><code><slot /></code></pre>
</figure>
<style>
  figure { margin: 0; background: var(--code-bg); color: var(--code-ink); border-radius: 14px; overflow: hidden; border: 1px solid var(--line); box-shadow: 8px 8px 0 var(--accent); }
  figcaption { display: flex; align-items: center; gap: 6px; padding: var(--s3) var(--s4); border-bottom: 1px solid #ffffff1f; font: 500 .8125rem var(--font-code); color: var(--c-dim); }
  figcaption i { width: 10px; height: 10px; border-radius: 50%; background: #ffffff33; }
  figcaption span { margin-left: var(--s2); }
  pre { margin: 0; padding: var(--s6) var(--s4); overflow-x: auto; font: 400 clamp(.875rem, .8rem + .4vw, 1rem)/1.9 var(--font-code); }
  code :global(.kw) { color: var(--c-kw); } code :global(.str) { color: var(--c-str); } code :global(.fn) { color: var(--c-fn); }
</style>
